{
  "name": "@hoop-master/features",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/features/src/index.js",
  "types": "dist/features/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/features/src/index.js",
      "types": "./dist/features/src/index.d.ts"
    },
    "./crm": {
      "import": "./dist/features/src/crm/index.js",
      "types": "./dist/features/src/crm/index.d.ts"
    },
    "./connectgbb": {
      "import": "./dist/features/src/connectgbb/index.js",
      "types": "./dist/features/src/connectgbb/index.d.ts"
    },
    "./connectgbb/*": "./dist/features/src/connectgbb/*",
    "./crm/*": "./dist/features/src/crm/*",
    "./coaching/*": "./dist/features/src/coaching/*",
    "./nil": {
      "import": "./dist/features/src/nil/index.js",
      "types": "./dist/features/src/nil/index.d.ts"
    },
    "./nil/*": "./dist/features/src/nil/*",
    "./recruiting/*": "./dist/features/src/recruiting/*",
    "./evaluations": {
      "import": "./dist/features/src/evaluations/index.js",
      "types": "./dist/features/src/evaluations/index.d.ts"
    },
    "./evaluations/*": "./dist/features/src/evaluations/*",
    "./scouting": {
      "import": "./dist/features/src/scouting/index.js",
      "types": "./dist/features/src/scouting/index.d.ts"
    },
    "./scouting/*": "./dist/features/src/scouting/*"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.3.0"
  }
}
