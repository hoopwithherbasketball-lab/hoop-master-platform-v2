{
  "extends": "@hoop-master/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@hoop-master/supabase": ["../../packages/supabase/src"],
      "@hoop-master/supabase/*": ["../../packages/supabase/src/*"],
      "@hoop-master/features/*": ["../../packages/features/src/*"],
      "@hoop-master/ui/*": ["../../packages/ui/src/*"],
      "@hoop-master/types": ["../../packages/types/src"],
      "@hoop-master/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src"]
}
