{
  "name": "hoop-master-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/run-builds.js",
    "build:turbo": "turbo build",
    "build:web": "node ./node_modules/turbo/bin/turbo build --filter=web",
    "dev:web": "cd apps/web && node ../../node_modules/vite/bin/vite.js --host",
    "typecheck": "tsc --noEmit",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "test:nil": "node tests/nil/nil-hub.test.cjs",
    "agile": "node scripts/hwh-agile.mjs",
    "agile:observe": "node scripts/hwh-agile.mjs --mode observe",
    "agile:test": "node --test scripts/hwh-agile-policy.test.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "turbo": "^2.9.9"
  },
  "packageManager": "npm@10.0.0"
}
