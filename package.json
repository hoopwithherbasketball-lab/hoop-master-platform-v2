{
  "name": "hoop-master-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:web": "turbo build --filter=web",
    "dev:web": "npm run dev -w apps/web -- --host",
    "typecheck": "npm run build -w apps/web",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "turbo": "^2.9.9"
  },
  "packageManager": "npm@10.0.0"
}
